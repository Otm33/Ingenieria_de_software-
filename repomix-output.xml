            return self._modelo_a_dominio(TMORM.objects.get(
                Q(id=trueque_id) & 
                (Q(emisor1_id=uid) | Q(receptor1_id=uid) | 
                 Q(emisor2_id=uid) | Q(receptor2_id=uid) | 
                 Q(emisor3_id=uid) | Q(receptor3_id=uid))
            ))
