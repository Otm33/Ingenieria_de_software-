            destinatario_id=uid,
            trueque_id=tid,
            tipo__in=tipos,
        ).exclude(estado="LEIDA").update(estado="LEIDA", leida_el=ahora)

    def marcar_leidas_por_trueque_ambos_usuarios(self, trueque_id: int, tipos=None) -> int:
