            <h3 class="modal-title">{{ modalDonacion.tipo === 'fondo' ? 'Donar al Fondo Comunitario' : 'Donar Horas a causa' }}</h3>
            <button class="modal-close" type="button" aria-label="Cerrar" @click="cerrarModalDonacion">×</button>
          </div>
